// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MANAGER
  ADMIN
  SUPER_ADMIN
}

enum GstRegistrationType {
  REGULAR
  COMPOSITION
  UNREGISTERED
}

enum MenuItemType {
  SERVED
  PACKAGED_GOODS
}

enum DietaryType {
  VEG
  NON_VEG
  EGG
}

enum Disable86Reason {
  OUT_OF_STOCK
  QUALITY
  PREP_TIME
  OTHER
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  OPEN
  COMPLETED
  VOID
}

enum OrderLineState {
  UNSENT
  FIRED
  PREPARING
  PREPARED
  SERVED
  VOID
}

enum PaymentMode {
  CASH
  UPI
  CARD
  OTHER
  // Added for supplier payments (purchasing). The POS offers only the four
  // above; its TS union in types/order.ts is deliberately narrower.
  BANK_TRANSFER
  CHEQUE
  MOBILE_MONEY
}

enum DiscountType {
  NONE
  PERCENT
  FLAT
}

/// Who placed an order line: restaurant STAFF (waiter/POS) or a guest via the
/// public self-order page (`/order/[username]`).
enum OrderSource {
  STAFF
  SELF_ORDER
}

/// Restaurant manager / operator account.
/// Phone number is the primary identifier used to sign in; email is optional
/// and can be added later for notifications (Resend).
model User {
  id              String    @id @default(cuid())
  phone           String    @unique
  phoneVerifiedAt DateTime?
  email           String?   @unique
  emailVerifiedAt DateTime?
  name            String?
  role            UserRole  @default(MANAGER)
  isActive        Boolean   @default(true)
  suspendedAt     DateTime?
  deletedAt       DateTime?

  // Optional sign-in PIN (scrypt-hashed) — an alternative to the SMS OTP.
  pinHash           String?
  pinUpdatedAt      DateTime?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedRestaurants Restaurant[]       @relation("RestaurantOwner")
  memberships      RestaurantMember[]

  @@index([role])
}

/// A restaurant onboarded onto the platform, owned by a manager (User).
enum RestaurantFormat {
  FINE_DINING
  CASUAL_DINING
  QSR
  CAFE
  CLOUD_KITCHEN
  BAR
  BAKERY
  FOOD_TRUCK
  OTHER
}

model Restaurant {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  username String? @unique
  email    String?
  phone    String?
  city     String?
  country  String  @default("IN")
  timezone String?

  // GST / tax profile (opt-in; drives the correct default tax at billing time)
  gstRegistrationType GstRegistrationType @default(UNREGISTERED)
  serviceGstRate      Decimal?            @db.Decimal(5, 2)
  pricesTaxInclusive  Boolean             @default(false)
  gstin               String?
  sacCode             String?             @default("996331")
  nextInvoiceSeq      Int                 @default(1)

  // Business / brand profile
  legalName        String?
  tagline          String?
  brandColor       String?
  logoUrl          String?
  coverUrl         String?
  addressLine1     String?
  addressLine2     String?
  state            String?
  postalCode       String?
  latitude         Float?
  longitude        Float?
  website          String?
  instagramUrl     String?
  facebookUrl      String?
  googleUrl        String?
  restaurantFormat RestaurantFormat?
  cuisines         String[]          @default([])
  seatingCapacity  Int?
  fssaiLicense     String?
  fssaiExpiry      DateTime?
  panNumber        String?
  serviceDineIn    Boolean           @default(true)
  serviceTakeaway  Boolean           @default(true)
  serviceDelivery  Boolean           @default(false)
  defaultOrderType OrderType         @default(TAKEAWAY)
  businessHours    Json?

  // Public guest self-ordering (`/order/[username]`); off until the owner opts in.
  selfOrderEnabled Boolean @default(false)

  // Custom note printed at the foot of the invoice/bill (owner-editable).
  invoiceFooterNote String?

  isActive    Boolean   @default(true)
  onboardedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  ownerId String
  owner   User   @relation("RestaurantOwner", fields: [ownerId], references: [id])

  categories     MenuCategory[]
  menuItems      MenuItem[]
  modifierGroups ModifierGroup[]
  orders         Order[]
  tables         DiningTable[]
  images         RestaurantImage[]
  videos         RestaurantVideo[]
  stockItems     StockItem[]
  staff          Staff[]

  documentSequences    DocumentSequence[]
  supplierGroups       SupplierGroup[]
  suppliers            Supplier[]
  requestsForQuotation RequestForQuotation[]
  supplierQuotations   SupplierQuotation[]
  purchaseOrders       PurchaseOrder[]
  purchaseReceipts     PurchaseReceipt[]
  purchaseInvoices     PurchaseInvoice[]
  supplierPayments     SupplierPayment[]
  supplierScorecards   SupplierScorecardPeriod[]

  customerGroups       CustomerGroup[]
  territories          Territory[]
  customers            Customer[]
  salesQuotations      SalesQuotation[]
  salesOrders          SalesOrder[]
  deliveryNotes        DeliveryNote[]
  salesInvoices        SalesInvoice[]
  customerPayments     CustomerPayment[]
  warehouses           Warehouse[]
  materialRequests     MaterialRequest[]
  stockEntries         StockEntry[]
  stockReconciliations StockReconciliation[]

  members RestaurantMember[]
  roles   AppRole[]

  @@index([ownerId])
  @@index([isActive])
}

/// A restaurant gallery image (Supabase Storage). Logo/cover are columns on
/// Restaurant; these are the extra showcase photos.
model RestaurantImage {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  url          String
  storageKey   String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
}

enum VideoKind {
  LINK
  FILE
}

/// A restaurant showcase video — either an external LINK (YouTube/Instagram/
/// Vimeo) or an uploaded FILE in Supabase Storage. Profile-only (never on bills).
model RestaurantVideo {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  kind         VideoKind
  url          String
  storageKey   String?
  caption      String?
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
}

/// One-time passcode challenge for phone (SMS) login. Codes are stored hashed.
model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

/// A menu section (Starters, Mains, Beverages…). Owned by a Restaurant.
model MenuCategory {
  id           String    @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  items      MenuItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

/// A sellable menu item. `price` is the base/default; variants (if any) are the
/// sellable units. Tax is resolved from the Restaurant profile unless the item
/// is PACKAGED_GOODS with its own goodsGstRate.
model MenuItem {
  id                String       @id @default(cuid())
  restaurantId      String
  categoryId        String
  name              String
  shortDescription  String?
  longDescription   String?
  itemType          MenuItemType @default(SERVED)
  dietaryType       DietaryType?
  price             Decimal      @db.Decimal(10, 2)
  priceTaxInclusive Boolean?
  goodsGstRate      Decimal?     @db.Decimal(5, 2)
  hsnSacCode        String?
  sortOrder         Int          @default(0)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  restaurant          Restaurant              @relation(fields: [restaurantId], references: [id])
  category            MenuCategory            @relation(fields: [categoryId], references: [id])
  images              MenuItemImage[]
  disables            MenuItemAvailability[]
  variants            MenuItemVariant[]
  modifierGroups      MenuItemModifierGroup[]
  recipe              RecipeComponent[]
  salesQuotationLines SalesQuotationItem[]
  salesOrderLines     SalesOrderItem[]
  deliveryNoteLines   DeliveryNoteItem[]
  salesInvoiceLines   SalesInvoiceItem[]

  @@index([restaurantId])
  @@index([categoryId])
}

/// Uploaded photo for a menu item (stored in Supabase Storage).
model MenuItemImage {
  id         String   @id @default(cuid())
  menuItemId String
  url        String
  storageKey String
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
}

/// A time-boxed "86" (disable) event for an item; also the availability audit log.
model MenuItemAvailability {
  id            String          @id @default(cuid())
  menuItemId    String
  reason        Disable86Reason
  note          String?
  disabledById  String
  disabledAt    DateTime        @default(now())
  resumeAt      DateTime?
  reenabledAt   DateTime?
  reenabledById String?

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
}

/// A size/portion variant of an item (Half/Full, S/M/L) with its own price.
model MenuItemVariant {
  id         String    @id @default(cuid())
  menuItemId String
  name       String
  price      Decimal   @db.Decimal(10, 2)
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
}

/// A reusable group of add-ons ("Milk", "Add-ons") attachable to many items.
model ModifierGroup {
  id           String    @id @default(cuid())
  restaurantId String
  name         String
  minSelect    Int       @default(0)
  maxSelect    Int       @default(1)
  isRequired   Boolean   @default(false)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  restaurant Restaurant              @relation(fields: [restaurantId], references: [id])
  modifiers  Modifier[]
  items      MenuItemModifierGroup[]

  @@index([restaurantId])
}

/// A single add-on option within a ModifierGroup, with a price delta.
model Modifier {
  id         String   @id @default(cuid())
  groupId    String
  name       String
  priceDelta Decimal  @default(0) @db.Decimal(10, 2)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

/// Join: which modifier groups apply to which items (groups are reusable).
model MenuItemModifierGroup {
  menuItemId      String
  modifierGroupId String
  sortOrder       Int    @default(0)

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, modifierGroupId])
  @@index([modifierGroupId])
}

/// A physical dining table the floor seats guests at. Owned by a Restaurant.
/// Soft-deleted (never hard-removed) so historical orders keep their link.
model DiningTable {
  id           String    @id @default(cuid())
  restaurantId String
  label        String
  seats        Int?
  section      String?
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  orders     Order[]

  @@unique([restaurantId, label])
  @@index([restaurantId])
}

/// A customer order (takeaway / dine-in tab / manual delivery). Stays OPEN and
/// mutable until settled; lines snapshot price + tax so old bills never change.
model Order {
  id              String      @id @default(cuid())
  restaurantId    String
  orderNumber     Int
  invoiceNumber   Int?
  idempotencyKey  String      @unique
  orderType       OrderType   @default(TAKEAWAY)
  status          OrderStatus @default(OPEN)
  tableLabel      String?
  tableId         String?
  customerName    String?
  customerPhone   String?
  customerAddress String?
  note            String?

  subtotal       Decimal      @default(0) @db.Decimal(10, 2)
  taxTotal       Decimal      @default(0) @db.Decimal(10, 2)
  discountType   DiscountType @default(NONE)
  discountValue  Decimal      @default(0) @db.Decimal(10, 2)
  discountReason String?
  discountTotal  Decimal      @default(0) @db.Decimal(10, 2)
  compTotal      Decimal      @default(0) @db.Decimal(10, 2)
  roundOff       Decimal      @default(0) @db.Decimal(10, 2)
  grandTotal     Decimal      @default(0) @db.Decimal(10, 2)

  placedById      String?
  placedByStaffId String?
  voidedById      String?
  voidReason      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  settledAt       DateTime?
  deletedAt       DateTime?

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id])
  table      DiningTable? @relation(fields: [tableId], references: [id])
  items      OrderItem[]
  payments   Payment[]

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, status])
  @@index([tableId])
}

/// One line on an order — fully snapshotted from the menu at add time.
model OrderItem {
  id           String         @id @default(cuid())
  orderId      String
  menuItemId   String?
  variantId    String?
  name         String
  variantName  String?
  unitPrice    Decimal        @db.Decimal(10, 2)
  quantity     Int            @default(1)
  lineNote     String?
  taxRate      Decimal        @default(0) @db.Decimal(5, 2)
  taxKind      String         @default("NONE")
  taxInclusive Boolean        @default(false)
  state        OrderLineState @default(UNSENT)
  source       OrderSource    @default(STAFF)
  isComp       Boolean        @default(false)
  compReason   String?
  firedAt      DateTime?
  voidReason   String?
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  modifiers OrderItemModifier[]

  @@index([orderId])
}

/// A chosen add-on on an order line — snapshotted.
model OrderItemModifier {
  id          String  @id @default(cuid())
  orderItemId String
  modifierId  String?
  name        String
  priceDelta  Decimal @default(0) @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

/// A tender against an order (multi-tender supported).
model Payment {
  id           String      @id @default(cuid())
  orderId      String
  mode         PaymentMode
  amount       Decimal     @db.Decimal(10, 2)
  tendered     Decimal?    @db.Decimal(10, 2)
  reference    String?
  receivedById String?
  createdAt    DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum StockUnit {
  KG
  GRAM
  LITRE
  ML
  PIECE
  PACK
  BOTTLE
  DOZEN
}

enum StockMovementType {
  RECEIVE
  WASTE
  CORRECTION
  SALE_DEPLETION
}

/// An inventory item the restaurant stocks. On-hand is the running total of
/// typed StockMovements — never edited directly. Soft-deleted.
model StockItem {
  id                String    @id @default(cuid())
  restaurantId      String
  name              String
  unit              StockUnit
  category          String?
  onHand            Decimal   @default(0) @db.Decimal(12, 3)
  reorderLevel      Decimal?  @db.Decimal(12, 3)
  parLevel          Decimal?  @db.Decimal(12, 3)
  costPerUnit       Decimal?  @db.Decimal(12, 2)
  /// Legacy free-text supplier hint, kept for existing rows. New code reads
  /// `defaultSupplier` first and falls back to this.
  supplier          String?
  defaultSupplierId String?
  notes             String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id])
  defaultSupplier Supplier?         @relation(fields: [defaultSupplierId], references: [id])
  movements       StockMovement[]
  usedIn          RecipeComponent[]

  bins                 Bin[]
  batches              Batch[]
  materialRequestLines MaterialRequestItem[]
  stockEntryLines      StockEntryItem[]
  reconciliationLines  StockReconciliationItem[]
  salesQuotationLines  SalesQuotationItem[]
  salesOrderLines      SalesOrderItem[]
  deliveryNoteLines    DeliveryNoteItem[]
  salesInvoiceLines    SalesInvoiceItem[]
  rfqLines             RfqItem[]
  quotationLines       SupplierQuotationItem[]
  purchaseOrderLines   PurchaseOrderItem[]
  receiptLines         PurchaseReceiptItem[]
  invoiceLines         PurchaseInvoiceItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

/// An audited change to a StockItem's on-hand. Manual RECEIVE/WASTE/CORRECTION
/// or SALE_DEPLETION (order placed = negative, void = positive).
model StockMovement {
  id                        String            @id @default(cuid())
  restaurantId              String
  stockItemId               String
  type                      StockMovementType
  quantity                  Decimal           @db.Decimal(12, 3)
  resultingOnHand           Decimal           @db.Decimal(12, 3)
  reason                    String?
  note                      String?
  orderId                   String?
  /// Set when this movement came from submitting a Purchase Receipt.
  purchaseReceiptItemId     String?
  warehouseId               String?
  deliveryNoteItemId        String?
  stockEntryItemId          String?
  stockReconciliationItemId String?
  createdById               String?
  createdAt                 DateTime          @default(now())

  stockItem               StockItem                @relation(fields: [stockItemId], references: [id])
  purchaseReceiptItem     PurchaseReceiptItem?     @relation(fields: [purchaseReceiptItemId], references: [id])
  warehouse               Warehouse?               @relation(fields: [warehouseId], references: [id])
  deliveryNoteItem        DeliveryNoteItem?        @relation(fields: [deliveryNoteItemId], references: [id])
  stockEntryItem          StockEntryItem?          @relation(fields: [stockEntryItemId], references: [id])
  stockReconciliationItem StockReconciliationItem? @relation(fields: [stockReconciliationItemId], references: [id])

  @@index([stockItemId])
  @@index([restaurantId, createdAt])
  @@index([orderId])
}

/// One ingredient line of a MenuItem's recipe. quantity is in the stock item's
/// unit. Placing an order depletes these; voiding restores them.
model RecipeComponent {
  id          String   @id @default(cuid())
  menuItemId  String
  stockItemId String
  quantity    Decimal  @db.Decimal(12, 3)
  createdAt   DateTime @default(now())

  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, stockItemId])
  @@index([menuItemId])
  @@index([stockItemId])
}

enum StaffRole {
  WAITER
  KITCHEN
  MANAGEMENT
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// A restaurant staff member (directory + POS PIN). Sensitive HR data (salary,
/// bank, ID proof) is deliberately out of scope. PIN is stored hashed only.
model Staff {
  id                    String          @id @default(cuid())
  restaurantId          String
  employeeCode          String
  name                  String
  role                  StaffRole
  status                StaffStatus     @default(ACTIVE)
  photoUrl              String?
  phone                 String
  email                 String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?
  postalCode            String?
  dateOfBirth           DateTime?
  gender                Gender?
  joiningDate           DateTime?
  employmentType        EmploymentType?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  pinHash               String
  loginFailedAttempts   Int             @default(0)
  loginLockedUntil      DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, employeeCode])
  @@index([restaurantId])
}

/// A registered Expo push token for a mobile client device. One row per
/// (subjectKind, subjectId, deviceId). Refreshed on every app-open — the
/// server upserts by the unique triple.
model PushToken {
  id            String   @id @default(cuid())
  subjectKind   String // "manager" | "staff"
  subjectId     String // User.id or Staff.id (application-managed FK; polymorphic)
  restaurantId  String?
  deviceId      String
  expoPushToken String
  platform      String // "ios" | "android"
  appVersion    String
  locale        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([subjectKind, subjectId, deviceId])
  @@index([subjectKind, subjectId])
  @@index([restaurantId])
}

// ═══════════════════════════════════════════════════════════════════════════
//  PURCHASING — ported from ERPNext's Buying module
//
//  Document chain, faithful to ERPNext:
//    Request for Quotation → Supplier Quotation → Purchase Order
//      → Purchase Receipt → Purchase Invoice → Supplier Payment
//
//  Deliberate reuse (no parallel structures):
//    · Purchase lines reference the existing `StockItem` — there is no second
//      item catalogue.
//    · Submitting a Purchase Receipt writes ordinary `StockMovement` RECEIVE
//      rows through the same repository the manual receive flow uses, linked
//      back via `StockMovement.purchaseReceiptItemId`. One stock ledger only.
//    · Supplier payments reuse the shared `PaymentMode` enum, extended with the
//      B2B modes; the POS keeps its own narrower union.
// ═══════════════════════════════════════════════════════════════════════════

/// Why a supplier is on hold — mirrors ERPNext's Supplier `hold_type`.
enum SupplierHoldType {
  ALL
  INVOICES
  PAYMENTS
}

enum RfqStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum SupplierQuotationStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_ORDERED
  ORDERED
  STOPPED
  EXPIRED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  ON_HOLD
  TO_RECEIVE_AND_BILL
  TO_RECEIVE
  TO_BILL
  COMPLETED
  CLOSED
  CANCELLED
}

enum PurchaseReceiptStatus {
  DRAFT
  TO_BILL
  PARTLY_BILLED
  COMPLETED
  RETURN
  CLOSED
  CANCELLED
}

enum PurchaseInvoiceStatus {
  DRAFT
  UNPAID
  PARTLY_PAID
  PAID
  OVERDUE
  RETURN
  DEBIT_NOTE_ISSUED
  CANCELLED
}

/// Scorecard banding — ERPNext ships these as editable "standings"; Restro
/// computes them from real purchase history instead of manual criteria.
enum ScorecardStanding {
  EXCELLENT
  VERY_GOOD
  GOOD
  AVERAGE
  POOR
}

/// Per-restaurant, per-document-type counter behind human-readable numbers
/// (ERPNext's `naming_series`). Sales invoices keep their own
/// `Restaurant.nextInvoiceSeq` — this covers the purchasing documents.
model DocumentSequence {
  id           String   @id @default(cuid())
  restaurantId String
  docType      String
  nextValue    Int      @default(1)
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, docType])
}

/// Supplier classification (ERPNext Supplier Group) — carries the default
/// payment terms new suppliers inherit.
model SupplierGroup {
  id                      String    @id @default(cuid())
  restaurantId            String
  name                    String
  defaultPaymentTermsDays Int?
  notes                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  suppliers  Supplier[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

/// A vendor the restaurant buys from (ERPNext Supplier, trimmed to the fields a
/// single-company restaurant actually uses).
model Supplier {
  id               String            @id @default(cuid())
  restaurantId     String
  code             String
  name             String
  supplierGroupId  String?
  taxId            String?
  contactPerson    String?
  email            String?
  phone            String?
  website          String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  country          String?
  /// null = the restaurant's own currency.
  currency         String?
  /// Default days from invoice date to due date.
  paymentTermsDays Int?
  onHold           Boolean           @default(false)
  holdType         SupplierHoldType?
  releaseDate      DateTime?
  preventRfq       Boolean           @default(false)
  preventPo        Boolean           @default(false)
  disabled         Boolean           @default(false)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  restaurant       Restaurant                @relation(fields: [restaurantId], references: [id])
  supplierGroup    SupplierGroup?            @relation(fields: [supplierGroupId], references: [id])
  suppliedItems    StockItem[]
  rfqInvitations   RfqSupplier[]
  quotations       SupplierQuotation[]
  purchaseOrders   PurchaseOrder[]
  receipts         PurchaseReceipt[]
  invoices         PurchaseInvoice[]
  payments         SupplierPayment[]
  scorecardPeriods SupplierScorecardPeriod[]

  @@unique([restaurantId, code])
  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([supplierGroupId])
}

/// Request for Quotation — asks several suppliers to price the same basket.
model RequestForQuotation {
  id              String    @id @default(cuid())
  restaurantId    String
  number          String
  transactionDate DateTime  @default(now())
  requiredBy      DateTime?
  status          RfqStatus @default(DRAFT)
  message         String?
  termsText       String?
  createdById     String?
  submittedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id])
  items      RfqItem[]
  suppliers  RfqSupplier[]
  quotations SupplierQuotation[]

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
}

model RfqItem {
  id          String    @id @default(cuid())
  rfqId       String
  stockItemId String
  description String?
  quantity    Decimal   @db.Decimal(12, 3)
  requiredBy  DateTime?
  sortOrder   Int       @default(0)

  rfq            RequestForQuotation     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  stockItem      StockItem               @relation(fields: [stockItemId], references: [id])
  quotationLines SupplierQuotationItem[]

  @@index([rfqId])
  @@index([stockItemId])
}

/// One supplier invited onto an RFQ.
model RfqSupplier {
  id          String    @id @default(cuid())
  rfqId       String
  supplierId  String
  emailSentAt DateTime?
  respondedAt DateTime?

  rfq      RequestForQuotation @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id])

  @@unique([rfqId, supplierId])
  @@index([supplierId])
}

/// A supplier's priced answer — standalone, or against an RFQ so quotes can be
/// compared line by line.
model SupplierQuotation {
  id              String                  @id @default(cuid())
  restaurantId    String
  number          String
  supplierId      String
  rfqId           String?
  transactionDate DateTime                @default(now())
  validUntil      DateTime?
  status          SupplierQuotationStatus @default(DRAFT)
  currency        String?
  subtotal        Decimal                 @default(0) @db.Decimal(14, 2)
  discountAmount  Decimal                 @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal                 @default(0) @db.Decimal(14, 2)
  grandTotal      Decimal                 @default(0) @db.Decimal(14, 2)
  notes           String?
  termsText       String?
  createdById     String?
  submittedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  restaurant     Restaurant              @relation(fields: [restaurantId], references: [id])
  supplier       Supplier                @relation(fields: [supplierId], references: [id])
  rfq            RequestForQuotation?    @relation(fields: [rfqId], references: [id])
  items          SupplierQuotationItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
  @@index([supplierId])
  @@index([rfqId])
}

model SupplierQuotationItem {
  id              String   @id @default(cuid())
  quotationId     String
  stockItemId     String
  rfqItemId       String?
  description     String?
  quantity        Decimal  @db.Decimal(12, 3)
  rate            Decimal  @db.Decimal(14, 2)
  discountPercent Decimal? @db.Decimal(5, 2)
  taxRate         Decimal  @default(0) @db.Decimal(5, 2)
  amount          Decimal  @db.Decimal(14, 2)
  leadTimeDays    Int?
  sortOrder       Int      @default(0)

  quotation SupplierQuotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  stockItem StockItem           @relation(fields: [stockItemId], references: [id])
  rfqItem   RfqItem?            @relation(fields: [rfqItemId], references: [id])
  orderedIn PurchaseOrderItem[]

  @@index([quotationId])
  @@index([stockItemId])
}

/// Purchase Order — the commitment to buy. `receivedPercent` / `billedPercent`
/// drive the ERPNext status ladder (To Receive and Bill → … → Completed).
model PurchaseOrder {
  id                  String              @id @default(cuid())
  restaurantId        String
  number              String
  supplierId          String
  supplierQuotationId String?
  transactionDate     DateTime            @default(now())
  scheduleDate        DateTime?
  status              PurchaseOrderStatus @default(DRAFT)
  currency            String?
  subtotal            Decimal             @default(0) @db.Decimal(14, 2)
  discountAmount      Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal            Decimal             @default(0) @db.Decimal(14, 2)
  roundOff            Decimal             @default(0) @db.Decimal(14, 2)
  grandTotal          Decimal             @default(0) @db.Decimal(14, 2)
  receivedPercent     Decimal             @default(0) @db.Decimal(6, 2)
  billedPercent       Decimal             @default(0) @db.Decimal(6, 2)
  advancePaid         Decimal             @default(0) @db.Decimal(14, 2)
  notes               String?
  termsText           String?
  holdComment         String?
  createdById         String?
  submittedAt         DateTime?
  cancelledAt         DateTime?
  closedAt            DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  restaurant        Restaurant          @relation(fields: [restaurantId], references: [id])
  supplier          Supplier            @relation(fields: [supplierId], references: [id])
  supplierQuotation SupplierQuotation?  @relation(fields: [supplierQuotationId], references: [id])
  items             PurchaseOrderItem[]
  receipts          PurchaseReceipt[]
  invoices          PurchaseInvoice[]

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id                      String    @id @default(cuid())
  purchaseOrderId         String
  stockItemId             String
  supplierQuotationItemId String?
  description             String?
  quantity                Decimal   @db.Decimal(12, 3)
  rate                    Decimal   @db.Decimal(14, 2)
  discountPercent         Decimal?  @db.Decimal(5, 2)
  taxRate                 Decimal   @default(0) @db.Decimal(5, 2)
  amount                  Decimal   @db.Decimal(14, 2)
  scheduleDate            DateTime?
  receivedQty             Decimal   @default(0) @db.Decimal(12, 3)
  billedQty               Decimal   @default(0) @db.Decimal(12, 3)
  sortOrder               Int       @default(0)

  purchaseOrder         PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  stockItem             StockItem              @relation(fields: [stockItemId], references: [id])
  supplierQuotationItem SupplierQuotationItem? @relation(fields: [supplierQuotationItemId], references: [id])
  receiptLines          PurchaseReceiptItem[]
  invoiceLines          PurchaseInvoiceItem[]

  @@index([purchaseOrderId])
  @@index([stockItemId])
}

/// Goods receipt. Submitting one is what actually moves stock — each accepted
/// line writes a RECEIVE `StockMovement`.
model PurchaseReceipt {
  id                   String                @id @default(cuid())
  restaurantId         String
  number               String
  supplierId           String
  purchaseOrderId      String?
  postingDate          DateTime              @default(now())
  status               PurchaseReceiptStatus @default(DRAFT)
  supplierDeliveryNote String?
  subtotal             Decimal               @default(0) @db.Decimal(14, 2)
  taxTotal             Decimal               @default(0) @db.Decimal(14, 2)
  grandTotal           Decimal               @default(0) @db.Decimal(14, 2)
  billedPercent        Decimal               @default(0) @db.Decimal(6, 2)
  isReturn             Boolean               @default(false)
  returnAgainstId      String?
  notes                String?
  createdById          String?
  submittedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  restaurant    Restaurant            @relation(fields: [restaurantId], references: [id])
  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  returnAgainst PurchaseReceipt?      @relation("ReceiptReturn", fields: [returnAgainstId], references: [id])
  returns       PurchaseReceipt[]     @relation("ReceiptReturn")
  items         PurchaseReceiptItem[]
  invoices      PurchaseInvoice[]

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
  @@index([supplierId])
  @@index([purchaseOrderId])
}

model PurchaseReceiptItem {
  id                  String    @id @default(cuid())
  purchaseReceiptId   String
  stockItemId         String
  purchaseOrderItemId String?
  description         String?
  /// Quantity accepted into stock.
  quantity            Decimal   @db.Decimal(12, 3)
  /// Quantity refused — recorded for the scorecard, never added to stock.
  rejectedQuantity    Decimal   @default(0) @db.Decimal(12, 3)
  rate                Decimal   @db.Decimal(14, 2)
  taxRate             Decimal   @default(0) @db.Decimal(5, 2)
  amount              Decimal   @db.Decimal(14, 2)
  batchNo             String?
  expiryDate          DateTime?
  billedQty           Decimal   @default(0) @db.Decimal(12, 3)
  sortOrder           Int       @default(0)

  purchaseReceipt   PurchaseReceipt       @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  stockItem         StockItem             @relation(fields: [stockItemId], references: [id])
  purchaseOrderItem PurchaseOrderItem?    @relation(fields: [purchaseOrderItemId], references: [id])
  movements         StockMovement[]
  invoiceLines      PurchaseInvoiceItem[]

  @@index([purchaseReceiptId])
  @@index([stockItemId])
}

/// Supplier bill. `updateStock` covers ERPNext's "invoice without receipt"
/// case, where the invoice itself is what moves stock.
model PurchaseInvoice {
  id                String                @id @default(cuid())
  restaurantId      String
  number            String
  /// The supplier's own invoice number (ERPNext `bill_no`).
  supplierInvoiceNo String?
  supplierId        String
  purchaseOrderId   String?
  purchaseReceiptId String?
  postingDate       DateTime              @default(now())
  dueDate           DateTime
  status            PurchaseInvoiceStatus @default(DRAFT)
  currency          String?
  subtotal          Decimal               @default(0) @db.Decimal(14, 2)
  discountAmount    Decimal               @default(0) @db.Decimal(14, 2)
  taxTotal          Decimal               @default(0) @db.Decimal(14, 2)
  roundOff          Decimal               @default(0) @db.Decimal(14, 2)
  grandTotal        Decimal               @default(0) @db.Decimal(14, 2)
  paidAmount        Decimal               @default(0) @db.Decimal(14, 2)
  outstandingAmount Decimal               @default(0) @db.Decimal(14, 2)
  updateStock       Boolean               @default(false)
  isReturn          Boolean               @default(false)
  returnAgainstId   String?
  notes             String?
  termsText         String?
  createdById       String?
  submittedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  restaurant      Restaurant                  @relation(fields: [restaurantId], references: [id])
  supplier        Supplier                    @relation(fields: [supplierId], references: [id])
  purchaseOrder   PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id])
  purchaseReceipt PurchaseReceipt?            @relation(fields: [purchaseReceiptId], references: [id])
  returnAgainst   PurchaseInvoice?            @relation("InvoiceReturn", fields: [returnAgainstId], references: [id])
  returns         PurchaseInvoice[]           @relation("InvoiceReturn")
  items           PurchaseInvoiceItem[]
  schedule        PurchasePaymentSchedule[]
  allocations     SupplierPaymentAllocation[]

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
  @@index([supplierId])
  @@index([dueDate])
}

model PurchaseInvoiceItem {
  id                    String   @id @default(cuid())
  purchaseInvoiceId     String
  stockItemId           String
  purchaseOrderItemId   String?
  purchaseReceiptItemId String?
  description           String?
  quantity              Decimal  @db.Decimal(12, 3)
  rate                  Decimal  @db.Decimal(14, 2)
  discountPercent       Decimal? @db.Decimal(5, 2)
  taxRate               Decimal  @default(0) @db.Decimal(5, 2)
  amount                Decimal  @db.Decimal(14, 2)
  sortOrder             Int      @default(0)

  purchaseInvoice     PurchaseInvoice      @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  stockItem           StockItem            @relation(fields: [stockItemId], references: [id])
  purchaseOrderItem   PurchaseOrderItem?   @relation(fields: [purchaseOrderItemId], references: [id])
  purchaseReceiptItem PurchaseReceiptItem? @relation(fields: [purchaseReceiptItemId], references: [id])

  @@index([purchaseInvoiceId])
  @@index([stockItemId])
}

/// Instalment line of a supplier bill (ERPNext Payment Schedule).
model PurchasePaymentSchedule {
  id                String   @id @default(cuid())
  purchaseInvoiceId String
  dueDate           DateTime
  invoicePortion    Decimal  @db.Decimal(5, 2)
  amount            Decimal  @db.Decimal(14, 2)
  paidAmount        Decimal  @default(0) @db.Decimal(14, 2)
  sortOrder         Int      @default(0)

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  @@index([purchaseInvoiceId])
}

/// Money paid out to a supplier (ERPNext Payment Entry, type Pay). Allocated
/// across one or more invoices; the remainder sits in `unallocatedAmount`.
model SupplierPayment {
  id                String      @id @default(cuid())
  restaurantId      String
  number            String
  supplierId        String
  paymentDate       DateTime    @default(now())
  mode              PaymentMode @default(CASH)
  amount            Decimal     @db.Decimal(14, 2)
  unallocatedAmount Decimal     @default(0) @db.Decimal(14, 2)
  referenceNo       String?
  referenceDate     DateTime?
  notes             String?
  createdById       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  restaurant  Restaurant                  @relation(fields: [restaurantId], references: [id])
  supplier    Supplier                    @relation(fields: [supplierId], references: [id])
  allocations SupplierPaymentAllocation[]

  @@unique([restaurantId, number])
  @@index([supplierId])
  @@index([restaurantId, paymentDate])
}

model SupplierPaymentAllocation {
  id                String  @id @default(cuid())
  supplierPaymentId String
  purchaseInvoiceId String
  amount            Decimal @db.Decimal(14, 2)

  supplierPayment SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)
  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])

  @@unique([supplierPaymentId, purchaseInvoiceId])
  @@index([purchaseInvoiceId])
}

/// A supplier's computed performance over a window — ERPNext's scorecard, but
/// derived from receipts and orders rather than hand-entered criteria.
model SupplierScorecardPeriod {
  id                     String            @id @default(cuid())
  restaurantId           String
  supplierId             String
  periodStart            DateTime
  periodEnd              DateTime
  onTimeDeliveryPercent  Decimal           @db.Decimal(5, 2)
  qualityAcceptedPercent Decimal           @db.Decimal(5, 2)
  priceVariancePercent   Decimal           @db.Decimal(6, 2)
  totalOrders            Int               @default(0)
  totalReceipts          Int               @default(0)
  totalPurchaseAmount    Decimal           @default(0) @db.Decimal(14, 2)
  score                  Decimal           @db.Decimal(5, 2)
  standing               ScorecardStanding
  generatedAt            DateTime          @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  supplier   Supplier   @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, periodStart, periodEnd])
  @@index([restaurantId])
}

// ═══════════════════════════════════════════════════════════════════════════
//  SELLING — ported from ERPNext's Selling module
//    Quotation → Sales Order → Delivery Note → Sales Invoice → Customer Payment
//  Statuses mirror ERPNext's own option lists.
// ═══════════════════════════════════════════════════════════════════════════

enum QuotationStatus {
  DRAFT
  OPEN
  REPLIED
  PARTIALLY_ORDERED
  ORDERED
  LOST
  EXPIRED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  ON_HOLD
  TO_DELIVER_AND_BILL
  TO_DELIVER
  TO_BILL
  COMPLETED
  CLOSED
  CANCELLED
}

enum DeliveryNoteStatus {
  DRAFT
  TO_BILL
  PARTLY_BILLED
  COMPLETED
  RETURN
  CLOSED
  CANCELLED
}

enum SalesInvoiceStatus {
  DRAFT
  UNPAID
  PARTLY_PAID
  PAID
  OVERDUE
  RETURN
  CREDIT_NOTE_ISSUED
  CANCELLED
}

/// Classification of a customer (ERPNext Customer Group).
model CustomerGroup {
  id                      String    @id @default(cuid())
  restaurantId            String
  name                    String
  defaultPaymentTermsDays Int?
  defaultDiscountPercent  Decimal?  @db.Decimal(5, 2)
  notes                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  customers  Customer[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

/// Sales territory (ERPNext Territory) — used to segment reporting.
model Territory {
  id           String    @id @default(cuid())
  restaurantId String
  name         String
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  customers  Customer[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

/// An account customer — corporate clients, caterers, delivery aggregators.
model Customer {
  id                 String    @id @default(cuid())
  restaurantId       String
  code               String
  name               String
  customerGroupId    String?
  territoryId        String?
  taxId              String?
  contactPerson      String?
  email              String?
  phone              String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?
  country            String?
  currency           String?
  paymentTermsDays   Int?
  /// Zero or null means no ceiling.
  creditLimit        Decimal?  @db.Decimal(14, 2)
  /// Block new sales orders once the credit limit is passed.
  blockOnCreditLimit Boolean   @default(true)
  loyaltyPoints      Int       @default(0)
  disabled           Boolean   @default(false)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  restaurant    Restaurant        @relation(fields: [restaurantId], references: [id])
  customerGroup CustomerGroup?    @relation(fields: [customerGroupId], references: [id])
  territory     Territory?        @relation(fields: [territoryId], references: [id])
  quotations    SalesQuotation[]
  salesOrders   SalesOrder[]
  deliveryNotes DeliveryNote[]
  salesInvoices SalesInvoice[]
  payments      CustomerPayment[]

  @@unique([restaurantId, code])
  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([customerGroupId])
}

/// A price offered to a customer before they commit (ERPNext Quotation).
model SalesQuotation {
  id              String          @id @default(cuid())
  restaurantId    String
  number          String
  customerId      String
  transactionDate DateTime        @default(now())
  validUntil      DateTime?
  status          QuotationStatus @default(DRAFT)
  currency        String?
  subtotal        Decimal         @default(0) @db.Decimal(14, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal         @default(0) @db.Decimal(14, 2)
  roundOff        Decimal         @default(0) @db.Decimal(14, 2)
  grandTotal      Decimal         @default(0) @db.Decimal(14, 2)
  lostReason      String?
  notes           String?
  termsText       String?
  createdById     String?
  submittedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  restaurant  Restaurant           @relation(fields: [restaurantId], references: [id])
  customer    Customer             @relation(fields: [customerId], references: [id])
  items       SalesQuotationItem[]
  salesOrders SalesOrder[]

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
  @@index([customerId])
}

model SalesQuotationItem {
  id              String   @id @default(cuid())
  quotationId     String
  menuItemId      String?
  stockItemId     String?
  itemName        String
  description     String?
  quantity        Decimal  @db.Decimal(12, 3)
  rate            Decimal  @db.Decimal(14, 2)
  discountPercent Decimal? @db.Decimal(5, 2)
  taxRate         Decimal  @default(0) @db.Decimal(5, 2)
  amount          Decimal  @db.Decimal(14, 2)
  sortOrder       Int      @default(0)

  quotation  SalesQuotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  menuItem   MenuItem?        @relation(fields: [menuItemId], references: [id])
  stockItem  StockItem?       @relation(fields: [stockItemId], references: [id])
  orderLines SalesOrderItem[]

  @@index([quotationId])
}

/// A confirmed customer commitment (ERPNext Sales Order).
model SalesOrder {
  id               String           @id @default(cuid())
  restaurantId     String
  number           String
  customerId       String
  quotationId      String?
  transactionDate  DateTime         @default(now())
  deliveryDate     DateTime?
  status           SalesOrderStatus @default(DRAFT)
  currency         String?
  subtotal         Decimal          @default(0) @db.Decimal(14, 2)
  discountAmount   Decimal          @default(0) @db.Decimal(14, 2)
  taxTotal         Decimal          @default(0) @db.Decimal(14, 2)
  roundOff         Decimal          @default(0) @db.Decimal(14, 2)
  grandTotal       Decimal          @default(0) @db.Decimal(14, 2)
  deliveredPercent Decimal          @default(0) @db.Decimal(6, 2)
  billedPercent    Decimal          @default(0) @db.Decimal(6, 2)
  advanceReceived  Decimal          @default(0) @db.Decimal(14, 2)
  poNumber         String?
  notes            String?
  termsText        String?
  holdComment      String?
  createdById      String?
  submittedAt      DateTime?
  cancelledAt      DateTime?
  closedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  restaurant    Restaurant       @relation(fields: [restaurantId], references: [id])
  customer      Customer         @relation(fields: [customerId], references: [id])
  quotation     SalesQuotation?  @relation(fields: [quotationId], references: [id])
  items         SalesOrderItem[]
  deliveryNotes DeliveryNote[]
  invoices      SalesInvoice[]

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
  @@index([customerId])
}

model SalesOrderItem {
  id                   String    @id @default(cuid())
  salesOrderId         String
  menuItemId           String?
  stockItemId          String?
  salesQuotationItemId String?
  itemName             String
  description          String?
  quantity             Decimal   @db.Decimal(12, 3)
  rate                 Decimal   @db.Decimal(14, 2)
  discountPercent      Decimal?  @db.Decimal(5, 2)
  taxRate              Decimal   @default(0) @db.Decimal(5, 2)
  amount               Decimal   @db.Decimal(14, 2)
  deliveryDate         DateTime?
  deliveredQty         Decimal   @default(0) @db.Decimal(12, 3)
  billedQty            Decimal   @default(0) @db.Decimal(12, 3)
  sortOrder            Int       @default(0)

  salesOrder         SalesOrder          @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  menuItem           MenuItem?           @relation(fields: [menuItemId], references: [id])
  stockItem          StockItem?          @relation(fields: [stockItemId], references: [id])
  salesQuotationItem SalesQuotationItem? @relation(fields: [salesQuotationItemId], references: [id])
  deliveryLines      DeliveryNoteItem[]
  invoiceLines       SalesInvoiceItem[]

  @@index([salesOrderId])
}

/// Goods handed to the customer (ERPNext Delivery Note). Submitting one issues
/// stock out of the warehouse it shipped from.
model DeliveryNote {
  id              String             @id @default(cuid())
  restaurantId    String
  number          String
  customerId      String
  salesOrderId    String?
  warehouseId     String?
  postingDate     DateTime           @default(now())
  status          DeliveryNoteStatus @default(DRAFT)
  subtotal        Decimal            @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal            @default(0) @db.Decimal(14, 2)
  grandTotal      Decimal            @default(0) @db.Decimal(14, 2)
  billedPercent   Decimal            @default(0) @db.Decimal(6, 2)
  isReturn        Boolean            @default(false)
  returnAgainstId String?
  driverName      String?
  vehicleNo       String?
  notes           String?
  createdById     String?
  submittedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id])
  customer      Customer           @relation(fields: [customerId], references: [id])
  salesOrder    SalesOrder?        @relation(fields: [salesOrderId], references: [id])
  warehouse     Warehouse?         @relation(fields: [warehouseId], references: [id])
  returnAgainst DeliveryNote?      @relation("DeliveryReturn", fields: [returnAgainstId], references: [id])
  returns       DeliveryNote[]     @relation("DeliveryReturn")
  items         DeliveryNoteItem[]
  invoices      SalesInvoice[]

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
  @@index([customerId])
}

model DeliveryNoteItem {
  id               String  @id @default(cuid())
  deliveryNoteId   String
  salesOrderItemId String?
  stockItemId      String?
  menuItemId       String?
  itemName         String
  description      String?
  quantity         Decimal @db.Decimal(12, 3)
  rate             Decimal @db.Decimal(14, 2)
  taxRate          Decimal @default(0) @db.Decimal(5, 2)
  amount           Decimal @db.Decimal(14, 2)
  batchNo          String?
  billedQty        Decimal @default(0) @db.Decimal(12, 3)
  sortOrder        Int     @default(0)

  deliveryNote   DeliveryNote       @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem?    @relation(fields: [salesOrderItemId], references: [id])
  stockItem      StockItem?         @relation(fields: [stockItemId], references: [id])
  menuItem       MenuItem?          @relation(fields: [menuItemId], references: [id])
  movements      StockMovement[]
  invoiceLines   SalesInvoiceItem[]

  @@index([deliveryNoteId])
}

/// A customer bill on account (ERPNext Sales Invoice). The POS keeps its own
/// Order/Payment path; this is the receivables side for account customers.
model SalesInvoice {
  id                String             @id @default(cuid())
  restaurantId      String
  number            String
  customerId        String
  salesOrderId      String?
  deliveryNoteId    String?
  postingDate       DateTime           @default(now())
  dueDate           DateTime
  status            SalesInvoiceStatus @default(DRAFT)
  currency          String?
  subtotal          Decimal            @default(0) @db.Decimal(14, 2)
  discountAmount    Decimal            @default(0) @db.Decimal(14, 2)
  taxTotal          Decimal            @default(0) @db.Decimal(14, 2)
  roundOff          Decimal            @default(0) @db.Decimal(14, 2)
  grandTotal        Decimal            @default(0) @db.Decimal(14, 2)
  paidAmount        Decimal            @default(0) @db.Decimal(14, 2)
  outstandingAmount Decimal            @default(0) @db.Decimal(14, 2)
  updateStock       Boolean            @default(false)
  isReturn          Boolean            @default(false)
  returnAgainstId   String?
  notes             String?
  termsText         String?
  createdById       String?
  submittedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  restaurant    Restaurant                  @relation(fields: [restaurantId], references: [id])
  customer      Customer                    @relation(fields: [customerId], references: [id])
  salesOrder    SalesOrder?                 @relation(fields: [salesOrderId], references: [id])
  deliveryNote  DeliveryNote?               @relation(fields: [deliveryNoteId], references: [id])
  returnAgainst SalesInvoice?               @relation("SalesInvoiceReturn", fields: [returnAgainstId], references: [id])
  returns       SalesInvoice[]              @relation("SalesInvoiceReturn")
  items         SalesInvoiceItem[]
  schedule      SalesPaymentSchedule[]
  allocations   CustomerPaymentAllocation[]

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
  @@index([customerId])
  @@index([dueDate])
}

model SalesInvoiceItem {
  id                 String   @id @default(cuid())
  salesInvoiceId     String
  salesOrderItemId   String?
  deliveryNoteItemId String?
  stockItemId        String?
  menuItemId         String?
  itemName           String
  description        String?
  quantity           Decimal  @db.Decimal(12, 3)
  rate               Decimal  @db.Decimal(14, 2)
  discountPercent    Decimal? @db.Decimal(5, 2)
  taxRate            Decimal  @default(0) @db.Decimal(5, 2)
  amount             Decimal  @db.Decimal(14, 2)
  sortOrder          Int      @default(0)

  salesInvoice     SalesInvoice      @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  salesOrderItem   SalesOrderItem?   @relation(fields: [salesOrderItemId], references: [id])
  deliveryNoteItem DeliveryNoteItem? @relation(fields: [deliveryNoteItemId], references: [id])
  stockItem        StockItem?        @relation(fields: [stockItemId], references: [id])
  menuItem         MenuItem?         @relation(fields: [menuItemId], references: [id])

  @@index([salesInvoiceId])
}

/// Instalment line of a customer bill (ERPNext Payment Schedule).
model SalesPaymentSchedule {
  id             String   @id @default(cuid())
  salesInvoiceId String
  dueDate        DateTime
  invoicePortion Decimal  @db.Decimal(5, 2)
  amount         Decimal  @db.Decimal(14, 2)
  paidAmount     Decimal  @default(0) @db.Decimal(14, 2)
  sortOrder      Int      @default(0)

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)

  @@index([salesInvoiceId])
}

/// Money received from a customer (ERPNext Payment Entry, type Receive).
model CustomerPayment {
  id                String      @id @default(cuid())
  restaurantId      String
  number            String
  customerId        String
  paymentDate       DateTime    @default(now())
  mode              PaymentMode @default(CASH)
  amount            Decimal     @db.Decimal(14, 2)
  unallocatedAmount Decimal     @default(0) @db.Decimal(14, 2)
  referenceNo       String?
  referenceDate     DateTime?
  notes             String?
  createdById       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  restaurant  Restaurant                  @relation(fields: [restaurantId], references: [id])
  customer    Customer                    @relation(fields: [customerId], references: [id])
  allocations CustomerPaymentAllocation[]

  @@unique([restaurantId, number])
  @@index([customerId])
  @@index([restaurantId, paymentDate])
}

model CustomerPaymentAllocation {
  id                String  @id @default(cuid())
  customerPaymentId String
  salesInvoiceId    String
  amount            Decimal @db.Decimal(14, 2)

  customerPayment CustomerPayment @relation(fields: [customerPaymentId], references: [id], onDelete: Cascade)
  salesInvoice    SalesInvoice    @relation(fields: [salesInvoiceId], references: [id])

  @@unique([customerPaymentId, salesInvoiceId])
  @@index([salesInvoiceId])
}

// ═══════════════════════════════════════════════════════════════════════════
//  STOCK — ported from ERPNext's Stock module
//    Warehouses + Bin, Material Request, Stock Entry (receipt / issue /
//    transfer), Stock Reconciliation, Batches.
// ═══════════════════════════════════════════════════════════════════════════

enum MaterialRequestType {
  PURCHASE
  MATERIAL_TRANSFER
  MATERIAL_ISSUE
  MANUFACTURE
}

enum MaterialRequestStatus {
  DRAFT
  SUBMITTED
  PENDING
  PARTIALLY_ORDERED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  ISSUED
  TRANSFERRED
  STOPPED
  CANCELLED
}

enum StockEntryPurpose {
  MATERIAL_RECEIPT
  MATERIAL_ISSUE
  MATERIAL_TRANSFER
  REPACK
  MANUFACTURE
}

enum StockDocStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

/// A place stock physically sits — main store, cold room, bar, a second outlet.
model Warehouse {
  id           String    @id @default(cuid())
  restaurantId String
  name         String
  code         String?
  parentId     String?
  /// Group warehouses hold no stock themselves; they only aggregate children.
  isGroup      Boolean   @default(false)
  isDefault    Boolean   @default(false)
  addressLine1 String?
  city         String?
  disabled     Boolean   @default(false)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  restaurant       Restaurant                @relation(fields: [restaurantId], references: [id])
  parent           Warehouse?                @relation("WarehouseTree", fields: [parentId], references: [id])
  children         Warehouse[]               @relation("WarehouseTree")
  bins             Bin[]
  movements        StockMovement[]
  deliveryNotes    DeliveryNote[]
  materialRequests MaterialRequestItem[]
  entriesFrom      StockEntryItem[]          @relation("EntryFromWarehouse")
  entriesTo        StockEntryItem[]          @relation("EntryToWarehouse")
  reconciliations  StockReconciliationItem[]
  batches          Batch[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([parentId])
}

/// Per-item, per-warehouse quantities (ERPNext Bin). `projectedQty` is
/// actual + ordered − reserved, which is what a reorder decision needs.
model Bin {
  id            String   @id @default(cuid())
  restaurantId  String
  stockItemId   String
  warehouseId   String
  actualQty     Decimal  @default(0) @db.Decimal(12, 3)
  reservedQty   Decimal  @default(0) @db.Decimal(12, 3)
  orderedQty    Decimal  @default(0) @db.Decimal(12, 3)
  indentedQty   Decimal  @default(0) @db.Decimal(12, 3)
  projectedQty  Decimal  @default(0) @db.Decimal(12, 3)
  valuationRate Decimal  @default(0) @db.Decimal(14, 4)
  stockValue    Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt     DateTime @updatedAt

  stockItem StockItem @relation(fields: [stockItemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([stockItemId, warehouseId])
  @@index([restaurantId])
  @@index([warehouseId])
}

/// A tracked lot with an expiry — the part of ERPNext batching a kitchen uses.
model Batch {
  id              String    @id @default(cuid())
  restaurantId    String
  stockItemId     String
  warehouseId     String?
  batchNo         String
  expiryDate      DateTime?
  manufactureDate DateTime?
  quantity        Decimal   @default(0) @db.Decimal(12, 3)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  stockItem StockItem  @relation(fields: [stockItemId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@unique([stockItemId, batchNo])
  @@index([restaurantId])
  @@index([expiryDate])
}

/// An internal request for goods (ERPNext Material Request).
model MaterialRequest {
  id              String                @id @default(cuid())
  restaurantId    String
  number          String
  type            MaterialRequestType   @default(PURCHASE)
  transactionDate DateTime              @default(now())
  requiredBy      DateTime?
  status          MaterialRequestStatus @default(DRAFT)
  requestedById   String?
  notes           String?
  submittedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  restaurant Restaurant            @relation(fields: [restaurantId], references: [id])
  items      MaterialRequestItem[]

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
}

model MaterialRequestItem {
  id                String    @id @default(cuid())
  materialRequestId String
  stockItemId       String
  warehouseId       String?
  description       String?
  quantity          Decimal   @db.Decimal(12, 3)
  orderedQty        Decimal   @default(0) @db.Decimal(12, 3)
  receivedQty       Decimal   @default(0) @db.Decimal(12, 3)
  requiredBy        DateTime?
  sortOrder         Int       @default(0)

  materialRequest MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  stockItem       StockItem       @relation(fields: [stockItemId], references: [id])
  warehouse       Warehouse?      @relation(fields: [warehouseId], references: [id])

  @@index([materialRequestId])
}

/// Receipt, issue or transfer of stock between warehouses (ERPNext Stock Entry).
model StockEntry {
  id           String            @id @default(cuid())
  restaurantId String
  number       String
  purpose      StockEntryPurpose
  postingDate  DateTime          @default(now())
  status       StockDocStatus    @default(DRAFT)
  totalValue   Decimal           @default(0) @db.Decimal(14, 2)
  reason       String?
  notes        String?
  createdById  String?
  submittedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id])
  items      StockEntryItem[]

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
}

model StockEntryItem {
  id              String  @id @default(cuid())
  stockEntryId    String
  stockItemId     String
  /// Set for issues and transfers — where the stock leaves from.
  fromWarehouseId String?
  /// Set for receipts and transfers — where the stock lands.
  toWarehouseId   String?
  quantity        Decimal @db.Decimal(12, 3)
  valuationRate   Decimal @default(0) @db.Decimal(14, 4)
  amount          Decimal @default(0) @db.Decimal(14, 2)
  batchNo         String?
  sortOrder       Int     @default(0)

  stockEntry    StockEntry      @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)
  stockItem     StockItem       @relation(fields: [stockItemId], references: [id])
  fromWarehouse Warehouse?      @relation("EntryFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse?      @relation("EntryToWarehouse", fields: [toWarehouseId], references: [id])
  movements     StockMovement[]

  @@index([stockEntryId])
}

/// A counted correction of on-hand and valuation (ERPNext Stock Reconciliation).
model StockReconciliation {
  id              String         @id @default(cuid())
  restaurantId    String
  number          String
  postingDate     DateTime       @default(now())
  status          StockDocStatus @default(DRAFT)
  differenceValue Decimal        @default(0) @db.Decimal(14, 2)
  reason          String?
  notes           String?
  createdById     String?
  submittedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  restaurant Restaurant                @relation(fields: [restaurantId], references: [id])
  items      StockReconciliationItem[]

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
}

model StockReconciliationItem {
  id                    String  @id @default(cuid())
  stockReconciliationId String
  stockItemId           String
  warehouseId           String?
  /// What the system believed, captured when the count was entered.
  currentQty            Decimal @default(0) @db.Decimal(12, 3)
  /// What was actually on the shelf.
  countedQty            Decimal @db.Decimal(12, 3)
  valuationRate         Decimal @default(0) @db.Decimal(14, 4)
  differenceQty         Decimal @default(0) @db.Decimal(12, 3)
  sortOrder             Int     @default(0)

  stockReconciliation StockReconciliation @relation(fields: [stockReconciliationId], references: [id], onDelete: Cascade)
  stockItem           StockItem           @relation(fields: [stockItemId], references: [id])
  warehouse           Warehouse?          @relation(fields: [warehouseId], references: [id])
  movements           StockMovement[]

  @@index([stockReconciliationId])
}

// ═══════════════════════════════════════════════════════════════════════════
//  ACCESS CONTROL — Discord-shaped roles
//
//  A person joins a restaurant as a member, and carries any number of roles.
//  Each role grants a level per module; a member's effective level for a module
//  is the highest any of their roles grants. The owner always has full access
//  and cannot be locked out.
// ═══════════════════════════════════════════════════════════════════════════

/// The areas of the app a role can be granted access to.
enum PermissionModule {
  PURCHASING
  SELLING
  STOCK
  INVENTORY
  MENU
  ORDERS
  TABLES
  STAFF
  REPORTS
  SETTINGS
}

/// What a role may do in a module. Levels are ordered: NONE < READ < EDIT.
enum PermissionLevel {
  NONE
  READ
  EDIT
}

/// A person's membership of a restaurant. The owner gets one automatically and
/// it can never be disabled.
model RestaurantMember {
  id           String   @id @default(cuid())
  restaurantId String
  userId       String
  isOwner      Boolean  @default(false)
  /// Free-text label shown instead of the account name, like a Discord nickname.
  displayName  String?
  invitedById  String?
  joinedAt     DateTime @default(now())
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id])
  user       User         @relation(fields: [userId], references: [id])
  roles      MemberRole[]

  @@unique([restaurantId, userId])
  @@index([restaurantId])
  @@index([userId])
}

/// A named bundle of permissions (ERPNext calls these Roles; the shape here is
/// Discord's — colours, ranking, and members holding several at once).
model AppRole {
  id           String    @id @default(cuid())
  restaurantId String
  name         String
  /// Hex colour used for the member's badge, e.g. "#8B54FE".
  color        String?
  /// Higher ranks sort first and show as the member's primary badge.
  rank         Int       @default(0)
  /// Grants everything, regardless of the per-module rows.
  isAdmin      Boolean   @default(false)
  /// Seeded roles that cannot be deleted, only edited.
  isSystem     Boolean   @default(false)
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  restaurant  Restaurant       @relation(fields: [restaurantId], references: [id])
  permissions RolePermission[]
  members     MemberRole[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

/// One role's level in one module. A missing row means NONE.
model RolePermission {
  id     String           @id @default(cuid())
  roleId String
  module PermissionModule
  level  PermissionLevel  @default(NONE)

  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
  @@index([roleId])
}

/// A member holds a role. Members can hold several; levels combine by taking
/// the highest.
model MemberRole {
  id         String   @id @default(cuid())
  memberId   String
  roleId     String
  assignedAt DateTime @default(now())

  member RestaurantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   AppRole          @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([memberId, roleId])
  @@index([roleId])
}
